# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase (Project Settings → API)
# إذا تُركت فارغة سيعمل الموقع على بيانات تجريبية (Mock Data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# المنطقة الزمنية لعرض مواعيد المباريات
NEXT_PUBLIC_APP_TIMEZONE=Asia/Bahrain

# رابط بث HLS تجريبي للمباريات التي لها بث في البيانات التجريبية (اختياري)
NEXT_PUBLIC_DEMO_STREAM_URL=

# ---------- المصادقة ----------
# مفتاح الخادم (Project Settings → API → service_role) — سري! يُستخدم في Paddle webhook فقط
SUPABASE_SERVICE_ROLE_KEY=
# عنوان الموقع (لروابط البريد وGoogle). يُستنتج تلقائياً إن تُرك فارغاً
NEXT_PUBLIC_SITE_URL=
# true بعد تفعيل Google في Supabase → Authentication → Providers
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# ---------- Paddle ----------
# sandbox للتجربة، production عند الإطلاق
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Developer Tools → Authentication → Client-side tokens (يبدأ بـ test_ أو live_)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Catalog → Products → RJ Premium → السعر الشهري 1.99$ (pri_...)
NEXT_PUBLIC_PADDLE_PRICE_ID=
# Developer Tools → Notifications → Webhook destination → Secret key (سري)
PADDLE_WEBHOOK_SECRET=
# Developer Tools → Authentication → API keys (سري) — لبوابة إدارة الاشتراك
PADDLE_API_KEY=
